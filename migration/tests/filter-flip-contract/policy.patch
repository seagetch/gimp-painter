+/* The old Filter flip invalidated its derived result without transforming
+ * the layer geometry or cached pixels. Other transforms retain native parent
+ * behavior; an image-wide flip still transforms the lower ordinary layers. */
+void flip (GimpItem *item, GimpContext *, GimpOrientationType, gdouble, gboolean)
+{
+  boundary_void (nullptr, [&] {
+    BindingStore::require (G_OBJECT (item)).with<FilterSlot> ([] (FilterImpl& impl) {
+      impl.invalidate ();
+    });
+  });
+}
 gboolean content_locked (GimpItem *item, GimpItem **locked) { if (locked) *locked = item; return TRUE; }
