   g_object_ref (image);
   private = GIMP_IMAGE_GET_PRIVATE (image);
 
+  /* Clone pixels are derived cache, not independently editable history.
+   * Collect drawable properties once and retain their object references across
+   * dirty/toggle callbacks through construction. Ordinary user locks are not
+   * this permanent type contract. Non-drawable Undo keeps its existing order. */
+  if (g_type_is_a (object_type, GIMP_TYPE_DRAWABLE_UNDO))
+    {
+      gboolean reject = FALSE;
+      gint     i;
+
+      if (! name)
+        name = gimp_undo_type_to_name (undo_type);
+      names = gimp_properties_append (object_type, &n_properties, names, &values,
+                                       "name", name, "image", image,
+                                       "undo-type", undo_type,
+                                       "dirty-mask", dirty_mask, NULL);
+      va_start (args, dirty_mask);
+      names = gimp_properties_append_valist (object_type, &n_properties,
+                                              names, &values, args);
+      va_end (args);
+      for (i = 0; i < n_properties; i++)
+        if (g_strcmp0 (names[i], "item") == 0)
+          reject = GIMP_IS_CLONE_LAYER (g_value_get_object (&values[i]));
+      if (reject)
+        {
+          gimp_properties_free (n_properties, names, values);
+          g_object_unref (image);
+          return NULL;
+        }
+    }
+
   /* Does this undo dirty the image?  If so, we always want to mark
