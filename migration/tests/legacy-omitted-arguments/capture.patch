+/* Observation wrapper only; all original writer bytes above are unchanged. */
+gboolean migration_capture_omission_write (FILE *, guint, guint, guint *, GError **);
+gboolean
+migration_capture_omission_write (FILE *fp, guint kind, guint variant,
+                                 guint *cursor, GError **error)
+{
+  XcfInfo info = { 0 };
+  GValue input = G_VALUE_INIT, sentinel = G_VALUE_INIT;
+  const guint8 bytes[] = { 3, 17, 255 };
+  const gdouble floats[] = { 0.25, -2.5, 128.0 };
+  gboolean ok;
+  info.fp = fp;
+  if (kind == 0) {
+    g_value_init (&input, GIMP_TYPE_INT8_ARRAY);
+    gimp_value_set_int8array (&input, variant == 2 ? NULL : bytes + variant, variant == 2 ? 0 : 3 - variant);
+  } else if (kind == 1) {
+    g_value_init (&input, GIMP_TYPE_FLOAT_ARRAY);
+    gimp_value_set_floatarray (&input, variant == 2 ? NULL : floats + variant, variant == 2 ? 0 : 3 - variant);
+  } else {
+    g_value_init (&input, GIMP_TYPE_DRAWABLE_ID);
+    g_value_set_int (&input, variant == 2 ? -1 : (variant ? 1234 : 42));
+  }
+  g_value_init (&sentinel, GIMP_TYPE_INT32);
+  g_value_set_int (&sentinel, 0x12345678);
+  ok = xcf_save_filter_spec_value (&info, NULL, error, &input) &&
+       xcf_save_filter_spec_value (&info, NULL, error, &sentinel);
+  if (ok) info.cp += xcf_write_zero_int32 (fp, 2, error);
+  g_value_unset (&input); g_value_unset (&sentinel);
+  *cursor = info.cp;
+  return ok && (!error || !*error);
+}
