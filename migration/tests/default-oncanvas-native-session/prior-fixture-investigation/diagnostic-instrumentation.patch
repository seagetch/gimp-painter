+/* Local diagnostic build only: no topology changes except explicit toggles. */
+static void dock_rootcause_trace (Gimp *gimp, const gchar *stage)
+{
+  if (!g_getenv ("GIMP_DOCK_ROOTCAUSE")) return;
+  GList *windows = gimp_get_image_windows (gimp);
+  guint left = 0, right = 0, floating = 0;
+  for (GList *i = windows; i; i = i->next) {
+    GimpImageWindow *window = i->data;
+    left += g_list_length (gimp_dock_columns_get_docks (gimp_image_window_get_left_docks (window)));
+    right += g_list_length (gimp_dock_columns_get_docks (gimp_image_window_get_right_docks (window)));
+  }
+  for (GList *i = gimp_dialog_factory_get_open_dialogs (gimp_dialog_factory_get_singleton ()); i; i = i->next)
+    if (GIMP_IS_DOCK_WINDOW (i->data)) floating++;
+  g_print ("DOCK-ROOTCAUSE stage=%s single=%d painter=%d restore_session=%d restore_pending=%d ready=%d image_windows=%u left=%u right=%u floating_windows=%u profile=%s\n",
+           stage, GIMP_GUI_CONFIG(gimp->config)->single_window_mode,
+           gimp->config->painter_canvas_ui, GIMP_GUI_CONFIG(gimp->config)->restore_session,
+           gimp_dialog_factory_restore_pending(gimp_dialog_factory_get_singleton()),
+           session_is_ready(gimp),g_list_length(windows),left,right,floating,gimp_directory());
+  g_list_free(windows);
+}
+static gboolean dock_rootcause_tick (gpointer data)
+{
+  Gimp *gimp=data;
+  guint stage=GPOINTER_TO_UINT(g_object_get_data(G_OBJECT(gimp),"dock-rootcause-stage"));
+  const gchar *toggle=g_getenv("GIMP_DOCK_ROOTCAUSE_TOGGLE");
+  if (!session_is_ready(gimp)) return G_SOURCE_CONTINUE;
+  if(g_getenv("GIMP_DOCK_ROOTCAUSE_NEW_IMAGE") &&
+     !g_object_get_data(G_OBJECT(gimp),"dock-rootcause-created-image")) {
+    dock_rootcause_trace(gimp,"settled-before-new-image");
+    GimpImage *image=gimp_image_new(gimp,256,256,GIMP_RGB,GIMP_PRECISION_U8_NON_LINEAR);
+    GimpLayer *layer=gimp_layer_new(image,256,256,gimp_image_get_layer_format(image,TRUE),"rootcause layer",1.0,GIMP_LAYER_MODE_NORMAL);
+    gimp_image_add_layer(image,layer,NULL,0,FALSE);
+    GimpDisplay *display=GIMP_DISPLAY(gimp_create_display(gimp,image,gimp_unit_pixel(),1.0,NULL));
+    GtkWidget *window=GTK_WIDGET(gimp_display_shell_get_window(gimp_display_get_shell(display)));
+    gtk_window_resize(GTK_WINDOW(window),1040,1800);
+    gtk_window_present(GTK_WINDOW(window));
+    g_object_unref(image);
+    g_object_set_data(G_OBJECT(gimp),"dock-rootcause-created-image",GINT_TO_POINTER(1));
+    return G_SOURCE_CONTINUE;
+  }
+  dock_rootcause_trace(gimp,stage==0?"settled":stage==1?"after-toggle-off":"after-toggle-on");
+  if (toggle && stage<2) {
+    g_object_set_data(G_OBJECT(gimp),"dock-rootcause-stage",GUINT_TO_POINTER(stage+1));
+    g_object_set(gimp->config,g_str_equal(toggle,"single")?"single-window-mode":"painter-canvas-ui",stage==1,NULL);
+    return G_SOURCE_CONTINUE;
+  }
+  if(g_getenv("GIMP_DOCK_ROOTCAUSE_SCREENSHOT")) {
+    GdkWindow *root=gdk_get_default_root_window();
+    GdkPixbuf *pixels=gdk_pixbuf_get_from_window(root,0,0,gdk_window_get_width(root),gdk_window_get_height(root));
+    if(pixels){gdk_pixbuf_save(pixels,g_getenv("GIMP_DOCK_ROOTCAUSE_SCREENSHOT"),"png",NULL,NULL);g_object_unref(pixels);}
+  }
+  if (g_getenv("GIMP_DOCK_ROOTCAUSE_EXIT")) gimp_exit(gimp,TRUE);
+  return G_SOURCE_REMOVE;
+}
 
