--- a/app/tests/test-xcf.c
+++ b/app/tests/test-xcf.c
@@ -977,6 +977,109 @@
  *  - Make sure that the information put into a #GimpImage is not lost
  *    when the #GimpImage is written to a file and then read again
  **/
+
+/* Bounded original-parser observation, not full-file Open acceptance.
+ * Actual old writer bytes are saved unchanged. The reader-positive variant
+ * changes only tag7 to tag8; the old writer never emitted that representation. */
+#include <stdio.h>
+extern gboolean migration_capture_string_write (FILE *, const gchar *, guint *, GError **);
+extern gboolean migration_capture_string_read (FILE *, GArray *, guint *);
+
+static void
+migration_observe_string (const gchar *path, const gchar *label,
+                          const gchar *expected, gboolean positive)
+{
+  FILE *fp = g_fopen (path, "rb");
+  GArray *args = g_array_new (FALSE, TRUE, sizeof (GValue));
+  guint cursor = 0, n, string_count = 0;
+  gboolean ok;
+  long size, position;
+  g_assert (fp != NULL);
+  g_assert_cmpint (fseek (fp, 0, SEEK_END), ==, 0);
+  size = ftell (fp);
+  rewind (fp);
+  ok = migration_capture_string_read (fp, args, &cursor);
+  position = ftell (fp);
+  g_print ("OBSERVE case=%s positive=%d ok=%d argc=%u cp=%u ftell=%ld bytes=%ld\n",
+           label, positive, ok, args->len, cursor, position, size);
+  for (n = 0; n < args->len; ++n)
+    {
+      GValue *value = &g_array_index (args, GValue, n);
+      const gchar *type = G_VALUE_TYPE (value) ? G_VALUE_TYPE_NAME (value) : "INVALID";
+      g_print ("ARG index=%u type=%s", n, type);
+      if (G_VALUE_HOLDS_STRING (value))
+        {
+          const gchar *text = g_value_get_string (value);
+          gchar *encoded = text ? g_base64_encode ((const guchar *) text, strlen (text)) : NULL;
+          g_print (" string_null=%d string_base64=%s", text == NULL, encoded ? encoded : "-");
+          g_free (encoded); ++string_count;
+        }
+      else if (G_VALUE_HOLDS_INT (value))
+        g_print (" int=%d", g_value_get_int (value));
+      g_print ("\n");
+    }
+  if (positive)
+    {
+      g_assert (ok);
+      g_assert_cmpuint (args->len, ==, 2);
+      g_assert_cmpuint (string_count, ==, 1);
+      g_assert (G_VALUE_HOLDS_STRING (&g_array_index (args, GValue, 0)));
+      g_assert_cmpstr (g_value_get_string (&g_array_index (args, GValue, 0)), ==, expected);
+      g_assert (G_VALUE_HOLDS_INT (&g_array_index (args, GValue, 1)));
+      g_assert_cmpint (g_value_get_int (&g_array_index (args, GValue, 1)), ==, 0x12345678);
+      g_assert_cmpuint (cursor, ==, size);
+      g_assert_cmpint (position, ==, size);
+    }
+  else
+    g_assert_cmpuint (string_count, ==, 0);
+  /* Invalid legacy placeholder values are observed, not passed to g_value_unset.
+   * The original parser allocates temporary GValues/strings; this capture does
+   * not alter those lifetime semantics or claim leak-free legacy parsing. */
+  for (n = 0; n < args->len; ++n)
+    if (G_VALUE_TYPE (&g_array_index (args, GValue, n)))
+      g_value_unset (&g_array_index (args, GValue, n));
+  g_array_free (args, TRUE);
+  fclose (fp);
+}
+
+static int
+migration_capture_strings (const gchar *directory)
+{
+  const gchar *names[] = { "ascii", "empty", "utf8", "null" };
+  const gchar *values[] = { "reader string", "", "日本語", NULL };
+  guint n;
+  for (n = 0; n < G_N_ELEMENTS (names); ++n)
+    {
+      gchar *filename = g_strdup_printf ("%s-writer-tag7.bin", names[n]);
+      gchar *path = g_build_filename (directory, filename, NULL);
+      gchar *reader_name = g_strdup_printf ("%s-controlled-tag8.bin", names[n]);
+      gchar *reader_path = g_build_filename (directory, reader_name, NULL);
+      FILE *fp = g_fopen (path, "wb");
+      GError *error = NULL;
+      guint cursor = 0;
+      gchar *bytes = NULL;
+      gsize length = 0;
+      g_assert (fp != NULL);
+      g_assert (migration_capture_string_write (fp, values[n], &cursor, &error));
+      g_assert_no_error (error);
+      g_assert_cmpint (fclose (fp), ==, 0);
+      g_assert (g_file_get_contents (path, &bytes, &length, &error));
+      g_assert_no_error (error);
+      g_assert_cmpuint (cursor, ==, length);
+      g_assert_cmpuint (length, >=, 28);
+      g_assert (bytes[0] == 0 && bytes[1] == 0 && bytes[2] == 0 && bytes[3] == 7);
+      bytes[3] = 8;
+      g_assert (g_file_set_contents (reader_path, bytes, length, &error));
+      g_assert_no_error (error);
+      g_free (bytes);
+      migration_observe_string (path, names[n], values[n], FALSE);
+      migration_observe_string (reader_path, names[n], values[n], TRUE);
+      g_free (filename); g_free (path); g_free (reader_name); g_free (reader_path);
+    }
+  g_print ("ORIGINAL_STRING_READER_VALUE_TYPE_ALIGNMENT_PASS cases=4\n");
+  return 0;
+}
