+/* Capture-only entry point: original writer above is unmodified. */
+gboolean migration_capture_string_write (FILE *, const gchar *, guint *, GError **);
+gboolean
+migration_capture_string_write (FILE *fp, const gchar *text,
+                                guint *cursor, GError **error)
+{
+  XcfInfo info = { 0 };
+  GValue string = G_VALUE_INIT, sentinel = G_VALUE_INIT;
+  gboolean ok;
+  info.fp = fp;
+  g_value_init (&string, G_TYPE_STRING);
+  g_value_set_string (&string, text);
+  g_value_init (&sentinel, GIMP_TYPE_INT32);
+  g_value_set_int (&sentinel, 0x12345678);
+  ok = xcf_save_filter_spec_value (&info, NULL, error, &string) &&
+       xcf_save_filter_spec_value (&info, NULL, error, &sentinel);
+  if (ok) info.cp += xcf_write_zero_int32 (fp, 2, error);
+  g_value_unset (&string); g_value_unset (&sentinel);
+  *cursor = info.cp;
+  return ok && (!error || !*error);
+}
