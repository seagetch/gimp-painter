  "fixes": {
    "queued_resize_after_last_image_close": {
      "cause": "A canvas size allocation checked for an image before scheduling its frame-clock tick. The deferred tick did not recheck, so closing the retained last display before that frame passed NULL into image size/resolution calculations.",
      "before_fix": {
        "target": "gimp:app / painter-perspective-ui",
        "result": "FAIL",
        "exit_code": -5,
        "duration_seconds": 3.7937662601470947,
        "cases": [
          "not ok /perspective-ui/close-pending-resize - Gimp-Core-FATAL-CRITICAL: gimp_image_get_resolution: assertion 'GIMP_IS_IMAGE (image)' failed"
        ]
      },
      "diagnostic_reproduction": {
        "target": "gimp:app / painter-perspective-ui",
        "result": "FAIL",
        "exit_code": -5,
        "duration_seconds": 3.0280513763427734,
        "cases": [
          "not ok /perspective-ui/close-pending-resize - Gimp-Core-FATAL-CRITICAL: gimp_image_get_resolution: assertion 'GIMP_IS_IMAGE (image)' failed"
        ]
      },
      "resolved_source_stack": [
        "gimp_display_shell_canvas_tick (temporary call-site backtrace)",
        "GTK/GDK frame-clock update",
        "gimp_test_run_mainloop_until_idle",
        "close_with_pending_resize"
      ],
      "repair": "Discard image-specific tick work once the display is empty/disconnected; clear pending resize/centering and release initial size request so the empty drop zone can draw.",
      "ownership": "Existing tool/image/display ownership and last-display close behavior unchanged",
      "regression": "Queues configure-resize work with a guide, closes the last image before the frame, observes a real painted frame, checks empty overlay and cleared centering flags, then reuses the display and adds a guide."
    },
    "old_toolrc_preserves_new_painter_tools": {
      "before_fix": {
        "target": "gimp:app / painter-perspective-ui",
        "result": "FAIL",
        "exit_code": -6,
        "duration_seconds": 4.277438640594482,
        "cases": [
          "ok 1 /perspective-ui/add-move-remove-undo",
          "ok 2 /perspective-ui/close-pending-resize",
          "ok 3 /perspective-ui/cancel-hit-transforms",
          "ok 4 /perspective-ui/overlay-extents-replace",
          "ok 5 /perspective-ui/overlay-pixels-image-switch",
          "ok 6 /perspective-ui/registration-external-replace",
          "not ok /perspective-ui/old-toolrc-preserves-groups - ERROR:../app/tests/test-painter-perspective-ui.c:235:old_toolrc_preserves_groups: 'gimp_tools_deserialize(gimp,items,scanner)' should be TRUE"
        ]
      },
      "cause": "The old v1 fixture predates three subsequently registered stable Painter tools. Deserialization grandfathered missing Perspective Guide only, so later tools caused old groups/order to be rejected.",
      "repair": "Extend only the existing new-Painter-tool compatibility allowlist with Fill Brush, Painter MyPaint and Painter Smudge; unknown and ordinary missing-tool validation is unchanged.",
      "appended_tools": [
        "gimp-perspective-guide-tool",
        "gimp-bucket-fill-brush-tool",
        "gimp-painter-mypaint-tool",
        "gimp-painter-smudge-tool"
      ],
      "fixture": "migration/fixtures/legacy-perspective/gimp3-before-ruler-toolrc",
      "fixture_sha256": "a7cdc7830d177f5c331311daf4f1261d720020df55fadfc2c991c70d0f84e02a",
      "fixture_unchanged_from_head": true,
      "regression": "All four tool names are absent from the unchanged fixture but present after deserialization, appended after its last original tool. Original first/second group active tools and first-group child order are retained."
    }
