+static gchar *
+capture_pixels_sha256 (GimpLayer *layer)
+{
+  GChecksum *sum=g_checksum_new(G_CHECKSUM_SHA256);
+  gint x,y;
+  guchar pixel[4];
+  gchar *result;
+  for(y=0;y<gimp_item_get_height(GIMP_ITEM(layer));y++)
+    for(x=0;x<gimp_item_get_width(GIMP_ITEM(layer));x++)
+      {
+        g_assert(gimp_pickable_get_pixel_at(GIMP_PICKABLE(layer),x,y,pixel));
+        g_checksum_update(sum,pixel,4);
+      }
+  result=g_strdup(g_checksum_get_string(sum));
+  g_checksum_free(sum);
+  return result;
+}
