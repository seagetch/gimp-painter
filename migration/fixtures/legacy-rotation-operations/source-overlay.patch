-                                                                        FALSE /*present*/);
-  GimpToolOptionsEditor *editor       = GIMP_TOOL_OPTIONS_EDITOR (gtk_bin_get_child (GTK_BIN (dockable)));
-
-  /* First select the rect select tool */
-  gimp_ui_manager_activate_action (ui_manager,
