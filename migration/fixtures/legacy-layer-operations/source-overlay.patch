+g_assert_cmpint(file_save(gimp,im,NULL,f,proc,GIMP_RUN_NONINTERACTIVE,FALSE,FALSE,FALSE,&err),==,GIMP_PDB_SUCCESS);
+g_assert_no_error(err);
+g_print("SAVE step=%s success=1\n",step);
