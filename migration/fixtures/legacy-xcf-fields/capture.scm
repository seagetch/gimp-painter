; Generated minimal owned test scenes, using the unchanged old PDB and writer.
(let* ((image (car (gimp-image-new 96 80 RGB)))
       (base (car (gimp-layer-new image 96 80 RGBA-IMAGE "field layer" 63 NORMAL-MODE)))
       (text (car (gimp-text-layer-new image "Editable old text" "Sans" 17 PIXELS)))
       (channel (car (gimp-channel-new image 96 80 "field channel" 37 '(31 67 211))))
       (unit (car (gimp-unit-new "field unit" 3.5 3 "fu" "fu" "field unit" "field units"))))
  (gimp-image-insert-layer image base 0 0)
  (gimp-drawable-fill base WHITE-FILL)
  (gimp-image-insert-layer image text 0 0)
  (gimp-item-set-name text "field text")
  (gimp-text-layer-set-color text '(27 57 91))
  (gimp-text-layer-set-kerning text TRUE)
  (gimp-text-layer-set-language text "en-US")
  (gimp-text-layer-set-indent text 2.5)
  (gimp-text-layer-set-line-spacing text 3.25)
  (gimp-text-layer-set-letter-spacing text 1.5)
  (gimp-layer-set-offsets text 5 9)
  (gimp-item-set-linked base TRUE)
  (gimp-item-set-lock-content base TRUE)
  (gimp-layer-set-lock-alpha base TRUE)
  (gimp-layer-add-mask base (car (gimp-layer-create-mask base ADD-WHITE-MASK)))
  (gimp-layer-set-apply-mask base FALSE)
  (gimp-layer-set-show-mask base TRUE)
  (gimp-layer-set-edit-mask base TRUE)
  (gimp-item-attach-parasite base '("field-layer-data" 1 "retained layer metadata"))
  (gimp-image-insert-channel image channel 0 0)
  (gimp-item-set-visible channel FALSE)
  (gimp-item-set-linked channel TRUE)
  (gimp-item-set-lock-content channel TRUE)
  (gimp-channel-set-show-masked channel TRUE)
  (gimp-item-attach-parasite channel '("field-channel-data" 1 "retained channel metadata"))
  (gimp-image-attach-parasite image '("field-image-data" 1 "retained image metadata"))
  (let* ((vectors (car (gimp-vectors-new image "field path")))
         (stroke (car (gimp-vectors-bezier-stroke-new-moveto vectors 5 7))))
    (gimp-vectors-bezier-stroke-lineto vectors stroke 13 17)
    (gimp-image-insert-vectors image vectors 0 0)
    (gimp-item-set-visible vectors TRUE)
    (gimp-item-set-linked vectors TRUE)
    (gimp-item-set-lock-content vectors TRUE)
    (gimp-item-attach-parasite vectors '("field-path-data" 1 "retained path metadata")))
  (gimp-image-set-resolution image 143 167)
  (gimp-image-set-unit image unit)
  (gimp-image-add-hguide image 13)
  (gimp-image-add-vguide image 17)
  (gimp-xcf-save RUN-NONINTERACTIVE image base "@OUT@/rgb-fields.xcf" "@OUT@/rgb-fields.xcf")
  (gimp-image-delete image))
(let* ((image (car (gimp-image-new 4 3 INDEXED)))
       (base (car (gimp-layer-new image 4 3 INDEXEDA-IMAGE "indexed fields" 100 NORMAL-MODE))))
  (gimp-image-set-colormap image 12 #(0 0 0 255 13 29 47 181 83 251 239 211))
  (gimp-image-insert-layer image base 0 0)
  (gimp-drawable-fill base TRANSPARENT-FILL)
  (gimp-image-set-unit image 2) ; GIMP_UNIT_MM
  (gimp-xcf-save RUN-NONINTERACTIVE image base "@OUT@/indexed-fields.xcf" "@OUT@/indexed-fields.xcf")
  (gimp-image-delete image))
(gimp-message "LEGACY_XCF_FIELDS_CAPTURE_COMPLETE")
