+  g_print("LEGACY_FILTER_CAPTURE_COMPLETE procedure=gimp-brightness-contrast args=3 brightness=25 contrast=-10 cache=identical source=verified\n");
+  /* read_args is a legacy shallow value copy; these three values are scalar. */
+  g_array_unref(read_args);
+  g_free(filename);
+}
