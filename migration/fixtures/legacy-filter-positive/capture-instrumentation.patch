+                   GPOINTER_TO_INT(g_object_get_data(G_OBJECT(filter),"migration-capture-completions")));
+          previous=pending;
+        }
+      if (!pending && g_object_get_data(G_OBJECT(filter),"migration-capture-completions"))
+        break;
+      g_usleep(1000);
+    }
+  g_print("FILTER_SAVE_STATE pending=%d completions=%d (not an idle assertion)\n",
+          gimp_filter_layer_capture_pending(GIMP_FILTER_LAYER(filter)),
+          GPOINTER_TO_INT(g_object_get_data(G_OBJECT(filter),"migration-capture-completions")));
+  /* The original built-in LUT path has no progress-end callback. */
+  g_assert(gimp_pickable_get_pixel_at(GIMP_PICKABLE(filter),12,12,pixel));
+  g_print("FILTER_CACHE_PIXEL x=12 y=12 rgba=%u,%u,%u,%u\n",pixel[0],pixel[1],pixel[2],pixel[3]);
+  cache_hash = capture_pixels_sha256(filter);
+  g_assert_cmpstr(cache_hash,==,control_hash);
+  g_free(control_hash);
+  g_print("FILTER_CACHE_SHA256 %s\n",cache_hash);
+  filename=g_build_filename(directory,"filter-brightness-contrast.xcf",NULL);
+  save_proc=file_procedure_find(gimp->plug_in_manager->save_procs,filename,&error);
+  g_assert_no_error(error);
+  g_assert_cmpint(file_save(gimp,image,NULL,filename,save_proc,GIMP_RUN_NONINTERACTIVE,FALSE,FALSE,FALSE,&error),==,GIMP_PDB_SUCCESS);
+  g_assert_no_error(error);
+  loaded=gimp_test_load_image(gimp,filename);
+  g_assert(loaded != NULL);
+  loaded_filter=GIMP_LAYER(gimp_container_get_child_by_index(gimp_image_get_layers(loaded),0));
+  g_assert(GIMP_IS_FILTER_LAYER(loaded_filter));
+  g_assert_cmpstr(gimp_filter_layer_get_procedure(GIMP_FILTER_LAYER(loaded_filter)),==,"gimp-brightness-contrast");
+  read_args=gimp_filter_layer_get_procedure_args(GIMP_FILTER_LAYER(loaded_filter));
+  g_assert_cmpuint(read_args->len,==,3);
+  g_assert_cmpint(g_value_get_int(&g_array_index(read_args,GValue,1)),==,25);
+  g_assert_cmpint(g_value_get_int(&g_array_index(read_args,GValue,2)),==,-10);
+  g_assert_cmpint(gimp_image_get_width(loaded),==,64);
+  g_assert_cmpint(gimp_image_get_height(loaded),==,64);
+  g_assert_cmpint(gimp_item_get_offset_x(GIMP_ITEM(loaded_filter)),==,0);
+  g_assert_cmpint(gimp_item_get_offset_y(GIMP_ITEM(loaded_filter)),==,0);
+  g_assert_cmpint(gimp_item_get_width(GIMP_ITEM(loaded_filter)),==,64);
+  g_assert_cmpint(gimp_item_get_height(GIMP_ITEM(loaded_filter)),==,64);
+  g_assert_cmpstr(gimp_object_get_name(loaded_filter),==,"brightness filter");
+  g_assert_cmpint(gimp_layer_get_mode(loaded_filter),==,GIMP_DIFFERENCE_MODE);
+  g_assert_cmpfloat(gimp_layer_get_opacity(loaded_filter),==,51.0/255.0);
+  loaded_source=GIMP_LAYER(gimp_container_get_child_by_index(gimp_image_get_layers(loaded),1));
+  g_assert(loaded_source != NULL);
+  g_assert_cmpint(gimp_container_get_n_children(gimp_image_get_layers(loaded)),==,2);
+  g_assert_cmpstr(gimp_object_get_name(loaded_source),==,"brightness source");
+  g_assert_cmpint(gimp_item_get_width(GIMP_ITEM(loaded_source)),==,24);
+  g_assert_cmpint(gimp_item_get_height(GIMP_ITEM(loaded_source)),==,20);
+  g_assert_cmpint(gimp_item_get_offset_x(GIMP_ITEM(loaded_source)),==,8);
+  g_assert_cmpint(gimp_item_get_offset_y(GIMP_ITEM(loaded_source)),==,7);
+  g_assert(gimp_pickable_get_pixel_at(GIMP_PICKABLE(loaded_source),0,0,pixel));
+  g_assert_cmpint(pixel[0],==,204); g_assert_cmpint(pixel[1],==,51);
+  g_assert_cmpint(pixel[2],==,102); g_assert_cmpint(pixel[3],==,255);
+  loaded_source_hash=capture_pixels_sha256(loaded_source);
+  g_assert_cmpstr(source_hash,==,loaded_source_hash);
+  g_print("REOPEN_LOWER_LAYER_SHA256 %s\n",loaded_source_hash);
+  g_free(source_hash); g_free(loaded_source_hash);
+  loaded_hash=capture_pixels_sha256(loaded_filter);
