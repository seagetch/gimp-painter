+#include "pdb/gimpprocedure.h"
+#include "core/gimpparamspecs.h"
+extern gint gimp_filter_layer_capture_pending (GimpFilterLayer *layer);
+
+static gchar *
+capture_pixels_sha256 (GimpLayer *layer)
+{
+  GChecksum *sum=g_checksum_new(G_CHECKSUM_SHA256);
+  gint x,y;
+  guchar pixel[4];
+  gchar *result;
+  for(y=0;y<gimp_item_get_height(GIMP_ITEM(layer));y++)
+    for(x=0;x<gimp_item_get_width(GIMP_ITEM(layer));x++)
+      {
+        g_assert(gimp_pickable_get_pixel_at(GIMP_PICKABLE(layer),x,y,pixel));
+        g_checksum_update(sum,pixel,4);
+      }
+  result=g_strdup(g_checksum_get_string(sum));
+  g_checksum_free(sum);
+  return result;
+}
+
+static void
+capture_filter_fixture (Gimp *gimp)
+{
+  const gchar *directory = g_getenv ("GIMP_PAINTER_FIXTURE_DIR");
+  GimpImage *image = gimp_create_image (gimp,64,64,GIMP_RGB,FALSE);
+  GimpLayer *source = gimp_layer_new (image,24,20,GIMP_RGBA_IMAGE,"brightness source",1.0,GIMP_NORMAL_MODE);
+  GimpLayer *filter = gimp_filter_layer_new (image,64,64,"brightness filter",0.2,GIMP_DIFFERENCE_MODE);
+  GimpRGB color = {0.8,0.2,0.4,1.0};
+  GimpProcedure *procedure = gimp_pdb_lookup_procedure (gimp->pdb,"gimp-brightness-contrast");
+  GValueArray *defaults;
+  GArray *args;
+  GArray *read_args;
+  guint i;
+  gint64 deadline;
+  gint previous = -1;
+  gchar *filename;
+  GimpPlugInProcedure *save_proc;
+  GError *error = NULL;
+  GimpImage *loaded;
+  GimpLayer *loaded_filter;
+  guchar pixel[4] = {0};
+  gchar *cache_hash, *loaded_hash;
+  GimpLayer *loaded_source;
+  GimpImage *control_image;
+  GimpLayer *control_layer;
+  GValueArray *control_args, *control_result;
+  gchar *control_hash, *source_hash, *loaded_source_hash;
+
+  g_assert (procedure != NULL);
+  defaults = gimp_procedure_get_arguments (procedure);
+  g_assert_cmpuint (defaults->n_values, ==, 3);
+  args = g_array_sized_new(FALSE,TRUE,sizeof(GValue),defaults->n_values);
+  g_array_set_clear_func(args,(GDestroyNotify)g_value_unset);
+  g_array_set_size(args,defaults->n_values);
+  for(i=0;i<defaults->n_values;i++)
+    {
+      GValue *value = &g_array_index(args,GValue,i);
+      g_value_init(value,G_VALUE_TYPE(&defaults->values[i]));
+      g_value_copy(&defaults->values[i],value);
+    }
+  g_value_set_int(&g_array_index(args,GValue,1),25);
+  g_value_set_int(&g_array_index(args,GValue,2),-10);
+  g_value_array_free(defaults);
+  g_assert(gimp_image_add_layer(image,source,NULL,0,FALSE));
+  gimp_item_set_offset(GIMP_ITEM(source),8,7);
+  gimp_drawable_fill(GIMP_DRAWABLE(source),&color,NULL);
+  gimp_drawable_update(GIMP_DRAWABLE(source),0,0,24,20);
+  gimp_pickable_flush(GIMP_PICKABLE(gimp_image_get_projection(image)));
+  source_hash=capture_pixels_sha256(source);
+  g_print("LOWER_LAYER_SHA256 %s\n",source_hash);
+  control_image=gimp_create_image(gimp,64,64,GIMP_RGB,FALSE);
+  control_layer=gimp_layer_new_from_tiles(gimp_pickable_get_tiles(GIMP_PICKABLE(gimp_image_get_projection(image))),control_image,GIMP_RGBA_IMAGE,"control normal layer",1.0,GIMP_NORMAL_MODE);
+  g_assert(gimp_image_add_layer(control_image,control_layer,NULL,0,FALSE));
+  control_args=gimp_procedure_get_arguments(procedure);
+  gimp_value_set_drawable(&control_args->values[0],GIMP_DRAWABLE(control_layer));
+  g_value_set_int(&control_args->values[1],25);
+  g_value_set_int(&control_args->values[2],-10);
+  control_result=gimp_procedure_execute(procedure,gimp,gimp_get_user_context(gimp),NULL,control_args,&error);
+  g_assert_no_error(error);
+  g_assert(control_result != NULL);
+  g_assert_cmpint(g_value_get_enum(&control_result->values[0]),==,GIMP_PDB_SUCCESS);
+  g_value_array_free(control_args); g_value_array_free(control_result);
+  control_hash=capture_pixels_sha256(control_layer);
+  g_print("CONTROL_ORIGINAL_PDB_CACHE_SHA256 %s\n",control_hash);
+  g_assert(gimp_image_add_layer(image,filter,NULL,0,FALSE));
+  gimp_filter_layer_set_procedure(GIMP_FILTER_LAYER(filter),"gimp-brightness-contrast",args);
+  g_array_unref(args);
+  gimp_drawable_update(GIMP_DRAWABLE(source),0,0,24,20);
+  gimp_pickable_flush(GIMP_PICKABLE(gimp_image_get_projection(image)));
+  deadline = g_get_monotonic_time() + 2 * G_USEC_PER_SEC;
+  while (g_get_monotonic_time() < deadline)
+    {
+      gint pending;
+      while (g_main_context_iteration(NULL,FALSE)) {}
+      gimp_pickable_flush(GIMP_PICKABLE(gimp_image_get_projection(image)));
+      g_assert(gimp_pickable_get_pixel_at(GIMP_PICKABLE(gimp_image_get_projection(image)),12,12,pixel));
+      pending = gimp_filter_layer_capture_pending(GIMP_FILTER_LAYER(filter));
+      if (pending != previous)
+        {
+          g_print("FILTER_STATE time_us=%" G_GINT64_FORMAT " pending=%d completions=%d\n",
