+static void
+capture_filter_fixture (Gimp *gimp)
+{
+  const gchar *directory = g_getenv ("GIMP_PAINTER_FIXTURE_DIR");
+  GimpImage *image = gimp_create_image (gimp,64,64,GIMP_RGB,FALSE);
+  GimpLayer *source = gimp_layer_new (image,24,20,GIMP_RGBA_IMAGE,"edge source",1.0,GIMP_NORMAL_MODE);
+  GimpLayer *filter = gimp_filter_layer_new (image,64,64,"edge filter",0.2,GIMP_DIFFERENCE_MODE);
+  GimpRGB color = {0.8,0.2,0.4,1.0};
+  GimpProcedure *procedure = gimp_pdb_lookup_procedure (gimp->pdb,"plug-in-edge");
+  GValueArray *defaults;
+  GArray *args;
+  GArray *read_args;
+  guint i;
+  gint64 deadline;
+  gint previous = -1;
+  gchar *filename;
+  GimpPlugInProcedure *save_proc;
+  GError *error = NULL;
+  GimpImage *loaded;
+  GimpLayer *loaded_filter;
+  guchar pixel[4] = {0};
+
+  g_assert (procedure != NULL);
+  defaults = gimp_procedure_get_arguments (procedure);
+  g_assert_cmpuint (defaults->n_values, ==, 6);
+  args = g_array_sized_new(FALSE,TRUE,sizeof(GValue),defaults->n_values);
+  g_array_set_clear_func(args,(GDestroyNotify)g_value_unset);
+  g_array_set_size(args,defaults->n_values);
+  for(i=0;i<defaults->n_values;i++)
+    {
+      GValue *value = &g_array_index(args,GValue,i);
+      g_value_init(value,G_VALUE_TYPE(&defaults->values[i]));
+      g_value_copy(&defaults->values[i],value);
+    }
+  g_value_set_int(&g_array_index(args,GValue,0),GIMP_RUN_NONINTERACTIVE);
+  g_value_set_double(&g_array_index(args,GValue,3),2.0);
+  g_value_set_int(&g_array_index(args,GValue,4),1);
+  g_value_set_int(&g_array_index(args,GValue,5),0);
+  g_value_array_free(defaults);
+  g_assert(gimp_image_add_layer(image,source,NULL,0,FALSE));
+  gimp_item_set_offset(GIMP_ITEM(source),8,7);
+  gimp_drawable_fill(GIMP_DRAWABLE(source),&color,NULL);
+  g_assert(gimp_image_add_layer(image,filter,NULL,0,FALSE));
+  gimp_filter_layer_set_procedure(GIMP_FILTER_LAYER(filter),"plug-in-edge",args);
+  g_array_unref(args);
+  gimp_drawable_update(GIMP_DRAWABLE(source),0,0,24,20);
+  gimp_pickable_flush(GIMP_PICKABLE(gimp_image_get_projection(image)));
+  deadline = g_get_monotonic_time() + 30 * G_USEC_PER_SEC;
+  while (g_get_monotonic_time() < deadline)
+    {
+      gint pending;
+      while (g_main_context_iteration(NULL,FALSE)) {}
+      gimp_pickable_flush(GIMP_PICKABLE(gimp_image_get_projection(image)));
+      g_assert(gimp_pickable_get_pixel_at(GIMP_PICKABLE(gimp_image_get_projection(image)),12,12,pixel));
+      pending = gimp_filter_layer_capture_pending(GIMP_FILTER_LAYER(filter));
+      if (pending != previous)
+        {
+          g_print("FILTER_STATE time_us=%" G_GINT64_FORMAT " pending=%d completions=%d\n",
+                   g_get_monotonic_time(),pending,
+                   GPOINTER_TO_INT(g_object_get_data(G_OBJECT(filter),"migration-capture-completions")));
+          previous=pending;
+        }
+      if (!pending && g_object_get_data(G_OBJECT(filter),"migration-capture-completions"))
+        break;
+      g_usleep(1000);
+    }
+  g_assert_cmpint(gimp_filter_layer_capture_pending(GIMP_FILTER_LAYER(filter)), ==, 0);
+  g_assert(g_object_get_data(G_OBJECT(filter),"migration-capture-completions") != NULL);
+  g_assert(gimp_pickable_get_pixel_at(GIMP_PICKABLE(filter),12,12,pixel));
+  g_print("FILTER_CACHE_PIXEL x=12 y=12 rgba=%u,%u,%u,%u\n",pixel[0],pixel[1],pixel[2],pixel[3]);
+  filename=g_build_filename(directory,"filter-edge.xcf",NULL);
+  save_proc=file_procedure_find(gimp->plug_in_manager->save_procs,filename,&error);
+  g_assert_no_error(error);
+  g_assert_cmpint(file_save(gimp,image,NULL,filename,save_proc,GIMP_RUN_NONINTERACTIVE,FALSE,FALSE,FALSE,&error),==,GIMP_PDB_SUCCESS);
+  g_assert_no_error(error);
+  loaded=gimp_test_load_image(gimp,filename);
+  g_assert(loaded != NULL);
+  loaded_filter=GIMP_LAYER(gimp_container_get_child_by_index(gimp_image_get_layers(loaded),0));
+  g_assert(GIMP_IS_FILTER_LAYER(loaded_filter));
+  g_assert_cmpstr(gimp_filter_layer_get_procedure(GIMP_FILTER_LAYER(loaded_filter)),==,"plug-in-edge");
+  read_args=gimp_filter_layer_get_procedure_args(GIMP_FILTER_LAYER(loaded_filter));
+  g_assert_cmpuint(read_args->len,==,6);
+  g_assert_cmpfloat(g_value_get_double(&g_array_index(read_args,GValue,3)),==,2.0);
+  g_assert_cmpint(g_value_get_int(&g_array_index(read_args,GValue,4)),==,1);
+  g_assert_cmpint(g_value_get_int(&g_array_index(read_args,GValue,5)),==,0);
+  g_print("LEGACY_FILTER_CAPTURE_COMPLETE procedure=plug-in-edge args=6 amount=2 wrap=1 algorithm=0\n");
+  /* read_args is a legacy shallow value copy; these six values are scalar. */
+  g_array_unref(read_args);
+  g_free(filename);
+}
