+/* Read-only capture instrumentation, excluded from the reference app binary. */
+extern "C" gint gimp_filter_layer_capture_pending(GimpFilterLayer* layer)
+{
+  auto* impl = dynamic_cast<GLib::FilterLayer*>(FilterLayerInterface::cast(layer));
+  return (impl->is_waiting_to_be_processed() ? 1 : 0) |
+         (impl->waiting_for_runner ? 2 : 0);
+}
diff --git a/app/tests/test-xcf.c b/app/tests/test-xcf.c
index dc071cb190..09569d38db 100644
--- a/app/tests/test-xcf.c
+++ b/app/tests/test-xcf.c
@@ -977,6 +977,281 @@ gimp_assert_mainimage (GimpImage *image,
  *  - Make sure that the information put into a #GimpImage is not lost
  *    when the #GimpImage is written to a file and then read again
  **/
+/* Controlled inputs, executed against the pinned legacy application core.
+ * Instrumentation only: no CloneLayer implementation changes. */
+#include "core/gimpclonelayer.h"
+#include "core/gimpcontainer.h"
+#include "core/gimppickable.h"
+#include "core/gimpprojection.h"
+
+static void
+capture_clone_fixture (Gimp *gimp, gboolean group_source)
+{
+  const gchar *directory = g_getenv ("GIMP_PAINTER_FIXTURE_DIR");
+  GimpImage *image = gimp_create_image (gimp, 64, 64, GIMP_RGB, FALSE);
+  GimpLayer *group = gimp_group_layer_new (image);
+  GimpLayer *source = gimp_layer_new (image, 24, 20, GIMP_RGBA_IMAGE,
+                                    "source child", 1.0, GIMP_NORMAL_MODE);
+  GimpLayer *clone;
+  GimpRGB red = { 0.75, 0.125, 0.25, 1.0 };
+  GimpPlugInProcedure *proc;
+  GimpImage *loaded;
+  GimpLayer *loaded_clone;
+  GimpLayer *loaded_source;
+  gchar *filename;
+  GError *error = NULL;
+  GimpPDBStatusType status;
+
+  gimp_object_set_name (GIMP_OBJECT (group), "source group");
+  g_assert (gimp_image_add_layer (image, group, NULL, 0, FALSE));
+  g_assert (gimp_image_add_layer (image, source, group, 0, FALSE));
+  gimp_item_set_offset (GIMP_ITEM (source), 8, 7);
+  gimp_drawable_fill (GIMP_DRAWABLE (source), &red, NULL);
+  gimp_drawable_update (GIMP_DRAWABLE (source), 0, 0, 24, 20);
+  gimp_pickable_flush (GIMP_PICKABLE (gimp_image_get_projection (image)));
+
+  clone = gimp_clone_layer_new (image, group_source ? group : source,
+                               24, 20, "clone", 1.0, GIMP_NORMAL_MODE);
+  g_assert (gimp_image_add_layer (image, clone, NULL, 0, FALSE));
+  gimp_item_set_offset (GIMP_ITEM (clone), 32, 30);
+  g_assert (gimp_clone_layer_get_source (GIMP_CLONE_LAYER (clone)) ==
+            (group_source ? group : source));
+  g_print ("CAPTURE_CLONE kind=%s width=%d height=%d x=%d y=%d pickable_opacity=%d\n",
+           group_source ? "group" : "normal-in-group",
+           gimp_item_get_width (GIMP_ITEM (clone)),
+           gimp_item_get_height (GIMP_ITEM (clone)),
+           gimp_item_get_offset_x (GIMP_ITEM (clone)),
+           gimp_item_get_offset_y (GIMP_ITEM (clone)),
+           gimp_pickable_get_opacity_at (GIMP_PICKABLE (clone), 0, 0));
+
+  filename = g_build_filename (directory, group_source ? "clone-group.xcf" : "clone-normal-in-group.xcf", NULL);
+  proc = file_procedure_find (gimp->plug_in_manager->save_procs, filename, &error);
+  g_assert_no_error (error);
+  g_assert (proc != NULL);
+  status = file_save (gimp, image, NULL, filename, proc, GIMP_RUN_NONINTERACTIVE,
+                      FALSE, FALSE, FALSE, &error);
+  g_assert_no_error (error);
+  g_assert_cmpint (status, ==, GIMP_PDB_SUCCESS);
+  loaded = gimp_test_load_image (gimp, filename);
+  g_assert (loaded != NULL);
+  loaded_clone = GIMP_LAYER (gimp_container_get_child_by_index (gimp_image_get_layers (loaded), 0));
+  g_assert (GIMP_IS_CLONE_LAYER (loaded_clone));
+  loaded_source = gimp_clone_layer_get_source (GIMP_CLONE_LAYER (loaded_clone));
+  g_assert (loaded_source != NULL);
+  g_assert_cmpstr (gimp_object_get_name (loaded_source), ==,
+                   group_source ? "source group" : "source child");
+  g_assert_cmpint (GIMP_IS_GROUP_LAYER (loaded_source), ==, group_source);
+  g_print ("CAPTURE_CLONE_REOPEN kind=%s type=%s source=%s source_type=%s width=%d height=%d x=%d y=%d\n",
+           group_source ? "group" : "normal-in-group", G_OBJECT_TYPE_NAME (loaded_clone),
+           gimp_object_get_name (loaded_source), G_OBJECT_TYPE_NAME (loaded_source),
+           gimp_item_get_width (GIMP_ITEM (loaded_clone)),
+           gimp_item_get_height (GIMP_ITEM (loaded_clone)),
+           gimp_item_get_offset_x (GIMP_ITEM (loaded_clone)),
+           gimp_item_get_offset_y (GIMP_ITEM (loaded_clone)));
+  g_free (filename);
+  /* Let process teardown reclaim the two test images, retaining borrowed sources. */
+}
