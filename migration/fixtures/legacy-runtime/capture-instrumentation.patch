+#include "core/gimplayermask.h"
+#include "core/gimpimage-undo.h"
+
+static void
+capture_clone_state (const gchar *label, GimpLayer *source, GimpLayer *clone)
+{
+  guchar s[4] = {0}, c[4] = {0};
+  gimp_drawable_update (GIMP_DRAWABLE (source), 0, 0,
+                        gimp_item_get_width (GIMP_ITEM (source)),
+                        gimp_item_get_height (GIMP_ITEM (source)));
+  g_assert (gimp_pickable_get_pixel_at (GIMP_PICKABLE (source), 0, 0, s));
+  g_assert (gimp_pickable_get_pixel_at (GIMP_PICKABLE (clone), 0, 0, c));
+  g_print ("CLONE_PIXEL %s source_rgba=%u,%u,%u,%u clone_rgba=%u,%u,%u,%u source_xy=%d,%d clone_xy=%d,%d source_wh=%d,%d clone_wh=%d,%d\n",
+           label, s[0],s[1],s[2],s[3],c[0],c[1],c[2],c[3],
+           gimp_item_get_offset_x (GIMP_ITEM (source)), gimp_item_get_offset_y (GIMP_ITEM (source)),
+           gimp_item_get_offset_x (GIMP_ITEM (clone)), gimp_item_get_offset_y (GIMP_ITEM (clone)),
+           gimp_item_get_width (GIMP_ITEM (source)), gimp_item_get_height (GIMP_ITEM (source)),
+           gimp_item_get_width (GIMP_ITEM (clone)), gimp_item_get_height (GIMP_ITEM (clone)));
+}
+
+static void
+capture_clone_semantics (Gimp *gimp)
+{
+  GimpImage *image = gimp_create_image (gimp, 64, 64, GIMP_RGB, FALSE);
+  GimpLayer *source = gimp_layer_new (image, 16, 16, GIMP_RGBA_IMAGE, "pixel source", 0.5, GIMP_NORMAL_MODE);
+  GimpLayer *other = gimp_layer_new (image, 16, 16, GIMP_RGBA_IMAGE, "other source", 1.0, GIMP_NORMAL_MODE);
+  GimpLayer *later;
+  GimpLayer *clone;
+  GimpLayerMask *mask;
+  GimpRGB color = {0.8,0.2,0.4,128.0/255.0};
+  GimpRGB gray = {128.0/255.0,128.0/255.0,128.0/255.0,1.0};
+  GError *error = NULL;
+  g_assert (gimp_image_add_layer (image, source, NULL, 0, FALSE));
+  g_assert (gimp_image_add_layer (image, other, NULL, 1, FALSE));
+  gimp_drawable_fill (GIMP_DRAWABLE (source), &color, NULL);
+  clone = gimp_clone_layer_new (image, source, 16,16,"pixel clone",1.0,GIMP_NORMAL_MODE);
+  g_assert (gimp_image_add_layer (image, clone, NULL, 0, FALSE));
+  gimp_item_set_offset (GIMP_ITEM (clone),32,30);
+  capture_clone_state ("opacity_half_alpha_128", source, clone);
+
+  mask = gimp_layer_create_mask (source, GIMP_ADD_WHITE_MASK, NULL);
+  gimp_drawable_fill (GIMP_DRAWABLE (mask), &gray, NULL);
+  g_assert (gimp_layer_add_mask (source, mask, FALSE, &error) == mask);
+  g_assert_no_error (error);
+  gimp_layer_mask_set_apply (mask, TRUE, FALSE);
+  capture_clone_state ("applied_mask_128", source, clone);
+  gimp_layer_mask_set_show (mask, TRUE, FALSE);
+  capture_clone_state ("show_mask", source, clone);
+  gimp_layer_mask_set_show (mask, FALSE, FALSE);
+  gimp_item_set_visible (GIMP_ITEM (source), FALSE, FALSE);
+  capture_clone_state ("hidden_source", source, clone);
+  gimp_item_set_visible (GIMP_ITEM (source), TRUE, FALSE);
+  gimp_layer_set_mode (source, GIMP_MULTIPLY_MODE, FALSE);
+  capture_clone_state ("multiply_source", source, clone);
+  gimp_layer_set_mode (source, GIMP_DISSOLVE_MODE, FALSE);
+  capture_clone_state ("dissolve_source", source, clone);
+  {
+    guchar alphas[256], sample[4];
+    gint x,y,count=0;
+    gchar *path=g_build_filename(g_getenv("GIMP_PAINTER_FIXTURE_DIR"),"clone-dissolve-alpha.bin",NULL);
+    gchar *checksum;
+    for(y=0;y<16;y++) for(x=0;x<16;x++) {
+      g_assert(gimp_pickable_get_pixel_at(GIMP_PICKABLE(clone),x,y,sample));
+      alphas[y*16+x]=sample[3];
+      if(sample[3]) count++;
+    }
+    g_assert(g_file_set_contents(path,(const gchar*)alphas,sizeof(alphas),NULL));
+    checksum=g_compute_checksum_for_data(G_CHECKSUM_SHA256,alphas,sizeof(alphas));
+    g_print("CLONE_DISSOLVE nonzero=%d bytes=256 sha256=%s first_rows=",count,checksum);
+    for(x=0;x<32;x++) g_print("%02x",alphas[x]);
+    g_print("\n");
+    g_free(checksum); g_free(path);
+  }
+  gimp_layer_set_mode (source, GIMP_MULTIPLY_MODE, FALSE);
+
+  gimp_item_set_offset (GIMP_ITEM (source),5,7);
+  capture_clone_state ("same_size_source_move", source, clone);
+  gimp_item_resize (GIMP_ITEM (source), gimp_get_user_context (gimp),20,18,-2,-3);
+  capture_clone_state ("source_resize", source, clone);
+  gimp_item_scale (GIMP_ITEM (clone),13,9,-5,4,GIMP_INTERPOLATION_NONE,NULL);
+  capture_clone_state ("clone_scale_noop", source, clone);
+
+  gimp_clone_layer_set_source_by_name (GIMP_CLONE_LAYER (clone), "later source");
+  gimp_clone_layer_set_source (GIMP_CLONE_LAYER (clone), other);
+  g_print ("CLONE_REFERENCE pending_missing_after_direct=%s\n",
+           gimp_object_get_name (gimp_clone_layer_get_source (GIMP_CLONE_LAYER (clone))));
+  later = gimp_layer_new (image,16,16,GIMP_RGBA_IMAGE,"later source",1.0,GIMP_NORMAL_MODE);
+  g_assert (gimp_image_add_layer (image,later,NULL,0,FALSE));
+  g_print ("CLONE_REFERENCE pending_resolved_after_insert=%s\n",
+           gimp_object_get_name (gimp_clone_layer_get_source (GIMP_CLONE_LAYER (clone))));
+  gimp_clone_layer_set_source (GIMP_CLONE_LAYER (clone),source);
+  g_print ("CLONE_REFERENCE direct_after_successful_resolution=%s\n",
+           gimp_object_get_name (gimp_clone_layer_get_source (GIMP_CLONE_LAYER (clone))));
+  gimp_image_remove_layer(image,source,TRUE,NULL);
+  g_print("CLONE_UNDO after_remove source_pointer_same=%d source_attached=%d\n",
+           gimp_clone_layer_get_source(GIMP_CLONE_LAYER(clone))==source,
+           gimp_item_is_attached(GIMP_ITEM(source)));
+  g_assert(gimp_image_undo(image));
+  g_print("CLONE_UNDO after_undo source_pointer_same=%d source_attached=%d\n",
+           gimp_clone_layer_get_source(GIMP_CLONE_LAYER(clone))==source,
+           gimp_item_is_attached(GIMP_ITEM(source)));
+  capture_clone_state("after_source_delete_undo",source,clone);
+}
