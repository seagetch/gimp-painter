; Controlled test stimulus for the real legacy PDB and XCF writer.
; This is not an observed tablet input recording.
(let* ((image (car (gimp-image-new 96 80 RGB)))
       (background (car (gimp-layer-new image 96 80 RGBA-IMAGE "background" 100 NORMAL-MODE)))
       (group (car (gimp-layer-group-new image)))
       (paint (car (gimp-layer-new image 80 64 RGBA-IMAGE "painted stroke" 75 MULTIPLY-MODE)))
       (brush (car (gimp-brush-new "migration-fixture-round")))
       (channel (car (gimp-channel-new image 96 80 "fixture channel" 50 '(255 0 0)))))
  (gimp-image-insert-layer image background 0 0)
  (gimp-drawable-fill background WHITE-FILL)
  (gimp-image-insert-layer image group 0 0)
  (gimp-item-set-name group "fixture group")
  (gimp-image-insert-layer image paint group 0)
  (gimp-drawable-fill paint TRANSPARENT-FILL)
  (gimp-layer-set-offsets paint 9 7)
  (gimp-brush-set-radius brush 6.0)
  (gimp-brush-set-hardness brush 1.0)
  (gimp-brush-set-spacing brush 20)
  (gimp-context-set-brush brush)
  (gimp-context-set-brush-size 12)
  (gimp-context-set-foreground '(192 32 64))
  (gimp-paintbrush-default paint 8 #(12 12 24 18 40 35 65 50))
  (gimp-layer-add-mask paint (car (gimp-layer-create-mask paint ADD-WHITE-MASK)))
  (gimp-image-insert-channel image channel 0 0)
  (gimp-item-set-visible channel FALSE)
  (gimp-image-set-resolution image 143 167)
  (gimp-image-select-rectangle image CHANNEL-OP-REPLACE 8 10 20 18)
  (gimp-xcf-save RUN-NONINTERACTIVE image paint "/workspace/shared/gimp-legacy-build/captures/ordinary-layers.xcf" "/workspace/shared/gimp-legacy-build/captures/ordinary-layers.xcf")
  (let* ((copy (car (gimp-image-duplicate image)))
         (merged (car (gimp-image-merge-visible-layers copy CLIP-TO-IMAGE))))
    (file-png-save RUN-NONINTERACTIVE copy merged "/workspace/shared/gimp-legacy-build/captures/ordinary-layers.png" "/workspace/shared/gimp-legacy-build/captures/ordinary-layers.png" 0 9 0 0 0 0 0)
    (gimp-image-delete copy))
  (gimp-image-delete image)
  (let* ((loaded (car (gimp-xcf-load RUN-NONINTERACTIVE "/workspace/shared/gimp-legacy-build/captures/ordinary-layers.xcf" "/workspace/shared/gimp-legacy-build/captures/ordinary-layers.xcf")))
         (roots (gimp-image-get-layers loaded))
         (loaded-group (vector-ref (cadr roots) 0))
         (children (gimp-item-get-children loaded-group))
         (loaded-paint (vector-ref (cadr children) 0))
         (offsets (gimp-drawable-offsets loaded-paint))
         (resolution (gimp-image-get-resolution loaded)))
    (if (not (= (car roots) 2)) (error "wrong root layer count"))
    (if (not (= (car children) 1)) (error "wrong group child count"))
    (if (not (string=? (car (gimp-item-get-name loaded-group)) "fixture group")) (error "group name changed"))
    (if (not (string=? (car (gimp-item-get-name loaded-paint)) "painted stroke")) (error "paint name changed"))
    (gimp-message (string-append "LEGACY_REOPEN_OPACITY=" (number->string (car (gimp-layer-get-opacity loaded-paint)))))
    (if (> (abs (- (car (gimp-layer-get-opacity loaded-paint)) (* 100.0 (/ 191.0 255.0)))) 0.000001) (error "opacity differs from legacy 8-bit quantization"))
    (if (not (= (car (gimp-layer-get-mode loaded-paint)) MULTIPLY-MODE)) (error "mode changed"))
    (if (not (= (car offsets) 9)) (error "x offset changed"))
    (if (not (= (cadr offsets) 7)) (error "y offset changed"))
    (if (not (> (car (gimp-layer-get-mask loaded-paint)) 0)) (error "mask missing"))
    (if (not (= (car (gimp-image-get-channels loaded)) 1)) (error "channel missing"))
    (if (not (= (car resolution) 143)) (error "x resolution changed"))
    (if (not (= (cadr resolution) 167)) (error "y resolution changed"))
    (if (not (= (car (gimp-image-width loaded)) 96)) (error "image width changed"))
    (if (not (= (car (gimp-image-height loaded)) 80)) (error "image height changed"))
    (if (not (= (car (gimp-drawable-width loaded-paint)) 80)) (error "layer width changed"))
    (if (not (= (car (gimp-drawable-height loaded-paint)) 64)) (error "layer height changed"))
    (let ((bounds (gimp-selection-bounds loaded)))
      (if (not (equal? bounds '(1 8 10 28 28))) (error "selection bounds changed")))
    (let* ((copy (car (gimp-image-duplicate loaded)))
           (merged (car (gimp-image-merge-visible-layers copy CLIP-TO-IMAGE))))
      (file-png-save RUN-NONINTERACTIVE copy merged "/workspace/shared/gimp-legacy-build/captures/ordinary-layers-reopened.png" "/workspace/shared/gimp-legacy-build/captures/ordinary-layers-reopened.png" 0 9 0 0 0 0 0)
      (gimp-image-delete copy))
    (gimp-image-delete loaded))
  (gimp-message "LEGACY_ORDINARY_CAPTURE_COMPLETE"))
