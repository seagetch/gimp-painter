+  core->stroke_to(GIMP_DRAWABLE(layer),i==7?0:.016,&c,options);
+ }
+ core->split_stroke();pixels(GIMP_PICKABLE(layer),4,"final.rgba");save(g,im,"final.xcf");g_print("STROKE_CAPTURE_COMPLETE events=18 input=synthetic-engine-boundary no-physical-tablet no-UI-path\n");
+}
+
+extern "C" void stroke_capture_verify(GimpImage *im){
+ g_assert_cmpint(gimp_image_get_width(im),==,96);g_assert_cmpint(gimp_image_get_height(im),==,80);
+ GimpContainer *layers=gimp_image_get_layers(im);g_assert_cmpint(gimp_container_get_n_children(layers),==,1);
+ GimpLayer *layer=GIMP_LAYER(gimp_container_get_child_by_index(layers,0));pixels(GIMP_PICKABLE(layer),4,"reopened.rgba");
+ g_print("STROKE_REOPEN_COMPLETE dimensions=96x80 layers=1\n");
+}
