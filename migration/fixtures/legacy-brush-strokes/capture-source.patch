+static gchar *path(const char *name){return g_build_filename(g_getenv("STROKE_CAPTURE_DIR"),name,NULL);}
+static void pixels(GimpPickable *p,int bpp,const char *name){guchar buf[96*80*4];GError *e=NULL;for(int y=0;y<80;y++)for(int x=0;x<96;x++)g_assert(gimp_pickable_get_pixel_at(p,x,y,buf+(y*96+x)*bpp));gchar *f=path(name);g_assert(g_file_set_contents(f,(char*)buf,96*80*bpp,&e));g_assert_no_error(e);g_free(f);}
+static void save(Gimp *g,GimpImage *im,const char *name){gchar *f=path(name);GError *e=NULL;GimpPlugInProcedure *p=file_procedure_find(g->plug_in_manager->save_procs,f,&e);g_assert_no_error(e);g_assert_cmpint(file_save(g,im,NULL,f,p,GIMP_RUN_NONINTERACTIVE,FALSE,FALSE,FALSE,&e),==,GIMP_PDB_SUCCESS);g_assert_no_error(e);g_free(f);}
+extern "C" void stroke_capture_run(Gimp *g){
+ guint processors=0;g_object_get(g->config,"num-processors",&processors,NULL);GDateTime *now=g_date_time_new_now_utc();gchar *stamp=g_date_time_format(now,"%Y-%m-%dT%H:%M:%SZ");g_print("CAPTURE_RUNTIME utc=%s glib=%u.%u.%u processors=%u\n",stamp,glib_major_version,glib_minor_version,glib_micro_version,processors);g_free(stamp);g_date_time_unref(now);
+ GError *error=NULL;GimpContext *context=gimp_get_user_context(g);
+ GList *loaded=gimp_mypaint_brush_load(context,g_getenv("STROKE_BRUSH"),&error);g_assert_no_error(error);g_assert(loaded);
+ GimpMypaintOptions *options=GIMP_MYPAINT_OPTIONS(g_object_new(GIMP_TYPE_MYPAINT_OPTIONS,"gimp",g,NULL));
+ gimp_context_set_mypaint_brush(GIMP_CONTEXT(options),GIMP_MYPAINT_BRUSH(loaded->data));
+ GimpRGB foreground={.12,.24,.7,1},background={1,1,1,1},paper={.92,.88,.8,1};
+ gimp_context_set_foreground(GIMP_CONTEXT(options),&foreground);gimp_context_set_background(GIMP_CONTEXT(options),&background);
+ GimpImage *im=gimp_create_image(g,96,80,GIMP_RGB,FALSE);GimpLayer *layer=gimp_layer_new(im,96,80,GIMP_RGBA_IMAGE,"original brush output",1,GIMP_NORMAL_MODE);g_assert(gimp_image_add_layer(im,layer,NULL,0,FALSE));gimp_drawable_fill(GIMP_DRAWABLE(layer),&paper,NULL);
+ GimpRGB inset={.8,.25,.15,1};gimp_context_set_foreground(context,&inset);
+ gimp_channel_select_rectangle(gimp_image_get_mask(im),40,0,56,80,GIMP_CHANNEL_OP_REPLACE,FALSE,0,0,FALSE);
+ g_assert(gimp_edit_fill(im,GIMP_DRAWABLE(layer),context,GIMP_FOREGROUND_FILL));gimp_channel_clear(gimp_image_get_mask(im),NULL,FALSE);
+ pixels(GIMP_PICKABLE(layer),4,"initial.rgba");pixels(GIMP_PICKABLE(gimp_image_get_mask(im)),1,"selection.u8");save(g,im,"initial.xcf");
+ GimpMypaintBrushPrivate *priv=(GimpMypaintBrushPrivate*)options->brush->p;
+ gchar *p=path("options.json");FILE *f=fopen(p,"w");fprintf(f,"{\"switches\":[");for(int i=BRUSH_BOOL_BASE;i<BRUSH_BOOL_END;i++)fprintf(f,"%s%s",i==BRUSH_BOOL_BASE?"":",",priv->get_bool_value(i)?"true":"false");fprintf(f,"],\"text\":[");for(int i=BRUSH_TEXT_BASE;i<BRUSH_TEXT_END;i++){char *v=priv->get_text_value(i);gchar *escaped=v?g_strescape(v,NULL):NULL;fprintf(f,"%s%s%s%s",i==BRUSH_TEXT_BASE?"":",",v?"\"":"",v?escaped:"null",v?"\"":"");g_free(escaped);}fprintf(f,"]}\n");fclose(f);g_free(p);
+ // Zero-initialized allocation avoids reading an indeterminate options pointer in the original constructor.
+ void *mem=g_malloc0(sizeof(GimpMypaintCore));GimpMypaintCore *core=new(mem) GimpMypaintCore();
+ for(int i=0;i<18;i++){
+  GimpCoords c={0};c.x=12+i*3.5;c.y=40+sin(i*.35)*12;c.pressure=i==17?0:(i==0?.15:(.25+.65*sin(i*3.141592653589793/17)));c.xtilt=-.3+i*.03;c.ytilt=.2-i*.02;c.wheel=i*.02;c.velocity=.2+i*.015;c.direction=i*.04;
+  if(i==7){c.x=12+6*3.5;c.y=40+sin(6*.35)*12;}
